# ==============================================================================
# Hexa Spark / AeroMesh API Production Dockerfile
# Python 3.11-slim, non-root user, $PORT binding, <512MB RAM budget
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /install

# Install build-time system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .

# Install API profile without any CUDA or heavy ML packages
RUN pip install --no-cache-dir --prefix=/install -r requirements-api.txt


# Final runtime image
FROM python:3.11-slim

# System dependencies for runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed python packages from builder
COPY --from=builder /install /usr/local

# Fix Docker image OpenCV conflict:
# Ensure no conflicting opencv-python or opencv-contrib-python exists,
# and enforce strictly opencv-python-headless==4.11.0.86
RUN pip uninstall -y opencv-python opencv-contrib-python || true && \
    pip install --no-cache-dir --force-reinstall --no-deps opencv-python-headless==4.11.0.86

# Build-time verification: verify the exact runtime tools and imports used by
# upload finalization without adding model or GPU packages to the image.
RUN python -c "import importlib.metadata as m, shutil, cv2, numpy, PIL; names={d.metadata['Name'].lower() for d in m.distributions()}; assert 'opencv-python-headless' in names; assert not ({'opencv-python','opencv-contrib-python','opencv-contrib-python-headless'} & names); assert cv2.__version__ and numpy.__version__ and PIL.__version__; assert shutil.which('ffmpeg') and shutil.which('ffprobe'), 'ffmpeg/ffprobe missing from runtime image'"

# Create non-root user and group
RUN groupadd -g 1001 aeromesh && \
    useradd -u 1001 -g aeromesh -s /bin/bash -m aeromesh

# Create data directories and set permissions
RUN mkdir -p /app/data/missions /app/data/objects /app/backend/models && \
    chown -R aeromesh:aeromesh /app

# Copy application source code
COPY backend/ /app/backend/
COPY alembic.ini /app/alembic.ini
COPY .env.example /app/.env.example

RUN chown -R aeromesh:aeromesh /app

USER aeromesh

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OBJECT_STORAGE_ROOT=/app/data/objects \
    PORT=8000 \
    PIPELINE_ENABLED=false \
    PROFILE=api \
    MALLOC_ARENA_MAX=2 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

EXPOSE 8000

# Healthcheck against /api/v1/health
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/v1/health || exit 1

# Execute uvicorn using $PORT dynamically assigned by cloud hosts like Render
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]

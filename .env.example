# ==============================================================================
# AeroMesh Production Environment Configuration (.env.example)
# Copy this file to .env and configure values before deploying in production.
# NEVER commit real production secrets or credentials to version control.
# ==============================================================================

# 1. Database Configuration (PostgreSQL 16 + PostGIS)
# Production: postgresql+psycopg://aeromesh:<STRONG_PASSWORD>@db:5432/aeromesh
# Development / Local fallback: leave empty to use SQLite/JSON storage
DATABASE_URL=postgresql+psycopg://aeromesh:change_me_production_password@localhost:5432/aeromesh

# 2. Redis & Celery Worker Configuration
# Broker URL for asynchronous job execution (detection, tracking, 3D reconstruction, fusion)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_REQUIRED=0

# 3. Security, Authentication & JWT Configuration
# Generate a secure 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# 4. Authentication Mode
# In production, set AEROMESH_AUTH_OPTIONAL=0 to enforce strict authentication on all write/report operations.
# For local evaluation and demo mode, set to 1.
AEROMESH_AUTH_OPTIONAL=1

# 5. CORS Allowed Origins (Comma-separated)
# In production, specify exact origin domains (e.g., https://aeromesh.internal,https://app.aeromesh.mil)
# If empty, development regex allows localhost on Vite ports (5173-5179)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# 6. Upload Limits & Rate Limiting
# Maximum flight video upload size in bytes (1073741824 = 1 GB)
MAX_UPLOAD_SIZE_BYTES=1073741824
# Sensitive endpoints rate limit per client IP per minute
RATE_LIMIT_PER_MINUTE=120

# 7. Storage Configuration
# Local storage root directory (defaults to data/objects)
OBJECT_STORAGE_ROOT=data/objects
# Optional S3 / MinIO Object Storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 8. AI Vision Models Configuration
YOLO_MODEL_PATH=backend/models/aeromesh_yolo.pt
YOLO_MODEL_VERSION=visdrone-v1.0
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.7
TRACKER_TYPE=bytetrack

# 9. Optional External AI Services (Roboflow Damage Detection)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=workspace/project/version

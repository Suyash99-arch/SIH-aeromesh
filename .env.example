# ==============================================================================
# Hexa Spark Production Environment Configuration (.env.example)
# Copy this file to .env and configure values before deploying in production.
# NEVER commit real production secrets or credentials to version control.
# ==============================================================================

# 1. API & Routing Configuration
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# 2. Database Configuration (PostgreSQL 16 + PostGIS)
# Production: postgresql+psycopg://aerouser:CHANGE_ME_DB_PASSWORD@db:5432/aeromesh_db
# Development / Local fallback: leave empty to use SQLite/JSON storage
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://aerouser:CHANGE_ME_DB_PASSWORD@localhost:5432/aeromesh_db

# 3. Redis & Celery Worker Configuration
# Broker URL for asynchronous job execution (detection, tracking, 3D reconstruction, fusion)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_REQUIRED=0

# 4. Security, Authentication & JWT Configuration
# Generate a secure 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Google OAuth Client ID (optional, leave empty to disable Google OAuth button)
GOOGLE_CLIENT_ID=

# 5. Authentication Mode
# In production, set AEROMESH_AUTH_OPTIONAL=0 to enforce strict authentication on all write/report operations.
# For local evaluation and demo mode, set to 1.
AEROMESH_AUTH_OPTIONAL=0

# 6. CORS Allowed Origins (Comma-separated exact URLs, wildcards forbidden when allow_credentials=True)
# Example: https://app.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# 7. Upload Limits & Rate Limiting
# Maximum flight video upload size in bytes (1073741824 = 1 GB)
MAX_UPLOAD_SIZE_BYTES=1073741824
# Sensitive endpoints rate limit per client IP per minute
RATE_LIMIT_PER_MINUTE=120

# 8. Storage Configuration (local | s3)
STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=data/objects

# Optional S3-Compatible / Cloudflare R2 / MinIO Storage Configuration
# For Cloudflare R2: S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# For MinIO: S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 9. AI Vision & Detection Configuration
YOLO_MODEL_PATH=backend/models/aeromesh_yolo.pt
YOLO_MODEL_VERSION=visdrone-v1.0
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.7
DETECTION_SAMPLE_FPS=2.0
DETECTION_IMGSZ=1280
DETECTION_TILE_IOU=0.5
DETECTION_TILE_OVERLAP=0.15
TRACKER_TYPE=bytetrack

# Open-vocabulary zero-shot detector model (e.g. yolo_world/l or yolo_world/m)
OPEN_VOCAB_MODEL=yolov8s-worldv2.pt

# 10. Video Processing & Proxy Generation
VIDEO_PROXY_MAX_WIDTH=1280

# 11. 3D Photogrammetry & Frame Quality Configuration
RECONSTRUCTION_MAX_IMAGE_DIM=1600
RECONSTRUCTION_OPTICAL_FLOW_THRESHOLD=0.8
FRAME_QUALITY_MIN_SHARPNESS=12.0
FRAME_QUALITY_MIN_BRIGHTNESS=15.0
FRAME_QUALITY_MAX_BRIGHTNESS=88.0
FRAME_QUALITY_MIN_FEATURES=25
FRAME_QUALITY_DIFF_THRESHOLD=3.0

# 12. Spatial 2D-to-3D Fusion Configuration
SPATIAL_FUSION_REPROJ_THRESHOLD=25.0

# 13. Optional External AI Services (Roboflow Damage Detection)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=workspace/project/version

# Hexa Spark Frontend Environment Configuration (.env.example)

# In production on Vercel:
# Option A (relative same-origin): leave as /api/v1 (routed via vercel.json rewrites)
# Option B (dedicated backend server): set to https://api.your-domain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Backward-compatibility alias
VITE_API_URL=/api/v1

# Optional Google OAuth Client ID (leave empty if Google OAuth is not configured)
VITE_GOOGLE_CLIENT_ID=

# ==============================================================================
# Hexa Spark Backend Environment Configuration (.env.example)
# Copy this file to .env or set environment variables before running the backend.
# ==============================================================================

# 1. API & Server Configuration
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# 2. Database Configuration
# In local demo/evaluation, SQLite/JSON fallback is used if DATABASE_URL is unset.
# For PostgreSQL: postgresql+psycopg://aerouser:CHANGE_ME_DB_PASSWORD@localhost:5432/aeromesh_db
DATABASE_URL=

# 3. Redis & Celery (Optional for local standalone demo)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_REQUIRED=0

# 4. Security & JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Authentication mode: 1 for local evaluation / demo mode, 0 for strict production auth
AEROMESH_AUTH_OPTIONAL=1

# 5. CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# 6. Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=209715200
MAX_STORAGE_BYTES=1073741824
AEROMESH_DATA_DIR=data
STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=data/objects

# 7. AI Vision & Photogrammetry Configuration
YOLO_MODEL_PATH=backend/models/aeromesh_yolo.pt
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.7
DETECTION_SAMPLE_FPS=2.0
DETECTION_IMGSZ=1280
TRACKER_TYPE=bytetrack

# COLMAP Reconstruction settings
COLMAP_MATCHER=sequential
COLMAP_OVERLAP=10
COLMAP_LOOP_DETECTION=false
RECONSTRUCTION_MAX_IMAGE_DIM=1600
SPATIAL_FUSION_REPROJ_THRESHOLD=25.0
